EXPO_PUBLIC_FIREBASE_PROJECT_ID= id del proyecto
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET= id del proyecto.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID= id del proyecto de mensajeria
EXPO_PUBLIC_FIREBASE_APP_ID= id del proyecto:web:tu app id