rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Verifica una permission key contra el campo resolvedPermissionKeys
    // del documento del usuario en Firestore (debe mantenerse sincronizado)
    function hasPermission(key) {
      return isSignedIn()
        && key in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.resolvedPermissionKeys;
    }

    function isAdminOrHasPermission(key) {
      return isAdmin() || hasPermission(key);
    }

    // System Master — acceso total de escritura a colecciones base
    function isSystemMaster() {
      return hasPermission('system:master');
    }

    // ── USERS ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read, list: if isSignedIn()
        && (request.auth.uid == uid || isAdminOrHasPermission('manage:users') || isSystemMaster());

      allow create: if isSignedIn() && request.auth.uid == uid;

      allow update: if isSignedIn() && (
        isAdmin()
        || isSystemMaster()
        || hasPermission('manage:users')
        || (
          request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['isBlocked', 'isActive', 'roleIds', 'permissionIds', 'isAdmin', 'resolvedPermissionKeys'])
        )
      );

      allow delete: if false;
    }

    // ── ROLES ─────────────────────────────────────────────────────────────────
    match /roles/{roleId} {
      allow read, list: if true;
      allow create, update: if isAdminOrHasPermission('manage:roles') || isSystemMaster();
      allow delete:         if isSystemMaster();
    }

    // ── PERMISSIONS ───────────────────────────────────────────────────────────
    match /permissions/{permId} {
      allow read, list: if isSignedIn();
      allow create, update: if isSystemMaster();
      allow delete:         if false;
    }

    // ── SCREENS ───────────────────────────────────────────────────────────────
    match /screens/{screenId} {
      allow read, list: if isSignedIn();
      allow create, update: if isAdminOrHasPermission('manage:screens') || isSystemMaster();
      allow delete:         if false;
    }

    // ── LOGS ──────────────────────────────────────────────────────────────────
    match /logs/{logId} {
      allow read, list: if isSignedIn();
      allow create:     if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── SESSIONS ──────────────────────────────────────────────────────────────
    match /sessions/{sessionId} {
      allow read, list: if isSignedIn();
      allow create:     if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update:     if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow delete:     if false;
    }

    // ── APP CONFIG ────────────────────────────────────────────────────────────
    match /app_config/{key} {
      allow read, list: if isSignedIn();
      allow create, update: if isSystemMaster();
      allow delete:         if false;
    }
  }
}
